generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Church {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  timezone      String          @default("America/Argentina/Buenos_Aires")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  activities    Activity[]
  activityTypes ActivityType[]
  auditLogs     AuditLog[]
  companions    Companion[]
  scHouseholds  ScHousehold[]
  users         User[]
  visitedPeople VisitedPerson[]
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  users       UserRole[]
}

model User {
  id                   String               @id @default(cuid())
  churchId             String
  firstName            String
  lastName             String
  email                String               @unique
  passwordHash         String
  status               UserStatus           @default(ACTIVE)
  lastLoginAt          DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  createdActivities    Activity[]           @relation("ActivityCreator")
  activityParticipates ActivityUser[]
  auditLogs            AuditLog[]
  resetTokens          PasswordResetToken[]
  createdHouseholds    ScHousehold[]        @relation("HouseholdCreator")
  church               Church               @relation(fields: [churchId], references: [id])
  roles                UserRole[]

  @@index([churchId, status])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model ActivityType {
  id                    String     @id @default(cuid())
  churchId              String
  code                  String
  name                  String
  description           String?
  requiresVisitedPerson Boolean    @default(false)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  activities            Activity[]
  church                Church     @relation(fields: [churchId], references: [id])

  @@unique([churchId, code])
  @@index([churchId, isActive])
}

model VisitedPerson {
  id         String              @id @default(cuid())
  churchId   String
  firstName  String
  lastName   String
  phone      String?
  address    String?
  notes      String?
  status     VisitedPersonStatus @default(ACTIVE)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  activities Activity[]
  church     Church              @relation(fields: [churchId], references: [id])

  @@index([churchId, status])
  @@index([churchId, lastName, firstName])
}

model Companion {
  id             String         @id @default(cuid())
  churchId       String
  firstName      String
  lastName       String
  phone          String?
  status         UserStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  participations ActivityUser[]
  church         Church         @relation(fields: [churchId], references: [id])

  @@index([churchId, status])
  @@index([churchId, lastName, firstName])
}

model Activity {
  id              String         @id @default(cuid())
  churchId        String
  activityTypeId  String
  scheduledAt     DateTime       @db.Timestamptz(3)
  place           String?
  visitedPersonId String?
  notes           String?
  status          ActivityStatus @default(SCHEDULED)
  createdById     String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  scHouseholdId   String?
  activityType    ActivityType   @relation(fields: [activityTypeId], references: [id])
  church          Church         @relation(fields: [churchId], references: [id])
  createdBy       User           @relation("ActivityCreator", fields: [createdById], references: [id])
  scHousehold     ScHousehold?   @relation(fields: [scHouseholdId], references: [id], onDelete: Restrict)
  visitedPerson   VisitedPerson? @relation(fields: [visitedPersonId], references: [id], onDelete: Restrict)
  participants    ActivityUser[]

  @@index([churchId, scheduledAt])
  @@index([churchId, status])
  @@index([visitedPersonId])
  @@index([scHouseholdId])
  @@index([createdById])
}

model ScHousehold {
  id            String            @id @default(cuid())
  churchId      String
  name          String
  address       String?
  phone         String?
  notes         String?
  frequencyDays Int?
  lastVisitAt   DateTime?         @db.Timestamptz(3)
  nextVisitAt   DateTime?
  status        HouseholdStatus   @default(ACTIVE)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  createdById   String
  activities    Activity[]
  members       HouseholdMember[]
  church        Church            @relation(fields: [churchId], references: [id])
  createdBy     User              @relation("HouseholdCreator", fields: [createdById], references: [id])

  @@index([churchId, status])
  @@index([churchId, nextVisitAt])
  @@index([createdById])
}

model HouseholdMember {
  id          String                @id @default(cuid())
  householdId String
  firstName   String
  lastName    String
  birthDate   DateTime?             @db.Date
  phone       String?
  status      HouseholdMemberStatus @default(ACTIVE)
  tasks       HouseholdMemberTask[] @default([])
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  household   ScHousehold           @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
}

model ActivityUser {
  id          String     @id @default(cuid())
  activityId  String
  userId      String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  companionId String?
  activity    Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  companion   Companion? @relation(fields: [companionId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@unique([activityId, companionId])
  @@index([companionId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  churchId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  church    Church   @relation(fields: [churchId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([churchId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VisitedPersonStatus {
  ACTIVE
  INACTIVE
}

enum ActivityStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum HouseholdStatus {
  ACTIVE
  INACTIVE
}

enum HouseholdMemberStatus {
  ACTIVE
  INACTIVE
}

enum HouseholdMemberTask {
  CORO
  ENSENANZA
  LIMPIEZA
  ARREGLO_FLORAL
  RESUMEN
}
